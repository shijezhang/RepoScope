# Optional. Core analysis does not require a model.
REPOSCOPE_HOME=artifacts/state
# Set absolute paths separated by the OS path separator if registering outside cwd.
# REPOSCOPE_ALLOWED_ROOTS=/absolute/path/to/repositories
# REPOSCOPE_LLM_BASE_URL=https://api.openai.com/v1
# REPOSCOPE_LLM_MODEL=
# REPOSCOPE_LLM_API_KEY=

# Optional local JSON/TOML/key=value provider config; never commit credentials.
# REPOSCOPE_LLM_CONFIG=/absolute/path/to/provider.local.json

# Optional short structured decisions for api.deepseek.com/deepseek-v4-* only.
# REPOSCOPE_LLM_THINKING=disabled
